{
  "name": "gitsentinel",
  "productName": "GitSentinel",
  "version": "1.0.0",
  "description": "Git 统一仓库纳管 · SSH 密钥与凭据安全中心 · 提交前智能拦截确认",
  "main": "main.js",
  "author": "GitSentinel Team",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.gitsentinel.app",
    "productName": "GitSentinel",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "main.js",
      "frontend/**/*",
      "assets/**/*",
      "backend/**/*",
      "interceptor/**/*",
      "sentinel.py"
    ],
    "extraResources": [
      {
        "from": "dist/GitSentinel",
        "to": "GitSentinel"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GitSentinel"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    }
  },
  "devDependencies": {
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3"
  }
}
